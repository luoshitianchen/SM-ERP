# 国密密钥，必须为 16 字节的 32 位十六进制字符串；生产环境通过密钥管理系统注入。
ERP_SM4_KEY_HEX=REPLACE_WITH_32_HEX_CHARACTERS_FROM_KMS
ERP_SM3_PASSWORD_ROUNDS=10000
# 生产环境必须关闭演示管理员密码。
ERP_BOOTSTRAP_PASSWORD=CHANGE_ME
# 与 SM Knowledge Bot 共享的随机集成密钥，至少 32 个随机字符。
ERP_KNOWLEDGE_BOT_INTEGRATION_KEY=REPLACE_WITH_RANDOM_INTEGRATION_KEY
# 密钥轮换期间可改用此变量，填写“新密钥,旧密钥”；轮换完成后仅保留新密钥。
ERP_KNOWLEDGE_BOT_INTEGRATION_KEYS=
ERP_INTEGRATION_RATE_WINDOW_SECONDS=60
ERP_INTEGRATION_RATE_MAX_REQUESTS=60
ERP_ENV=production
ERP_LOGIN_RATE_WINDOW_SECONDS=60
ERP_LOGIN_RATE_MAX_REQUESTS=20
ERP_MAX_REQUEST_BYTES=1048576
ERP_ALLOWED_HOSTS=localhost,127.0.0.1,ERP_INTERNAL_HOST
ERP_ENABLE_DOCS=false
